# Copy to .env and fill in what you use.

# --gpt_model via OpenAI (default provider)
OPENAI_API_KEY="XXX"

# --*_claude
ANTHROPIC_API_KEY="XXX"

# --provider openweight: an OpenAI-compatible endpoint serving open-weight
# models (e.g. gpt-oss-120b, llama-3.3-70b, gemma-4-31b), such as a vLLM server
OPENWEIGHT_BASE_URL="https://your-endpoint/v1"
OPENWEIGHT_API_KEY="XXX"
